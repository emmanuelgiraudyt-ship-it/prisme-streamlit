# Copier ce fichier en .streamlit/secrets.toml (jamais versionné) ou le coller
# dans Streamlit Community Cloud : Settings > Secrets.

# --- Modèle (obligatoire) ---
ANTHROPIC_API_KEY = "sk-ant-..."
# PRISME_MODEL = "claude-sonnet-4-6"        # modèle utilisé (optionnel)
# PRISME_DAILY_LIMIT = "200"                # plafond de générations par espace et par jour

# Fournisseur alternatif compatible OpenAI (Mistral, hébergeur souverain). Expérimental.
# PRISME_PROVIDER = "openai"
# PRISME_OPENAI_BASE_URL = "https://api.mistral.ai/v1"
# PRISME_OPENAI_API_KEY = "..."
# PRISME_OPENAI_MODEL = "mistral-large-latest"

# --- Comptes (obligatoire hors essai local) ---
# Un compte = un espace de données cloisonné. Générer un hachage :
#   python scripts/hash_password.py
[users]
cabinet = "pbkdf2_sha256$240000$..."

# --- Notion (optionnel) : intégration interne partagée avec la page ou la base cible ---
# NOTION_TOKEN = "secret_..."
# NOTION_PARENT_PAGE_ID = "https://www.notion.so/Ma-page-0123456789abcdef0123456789abcdef"
# NOTION_DATABASE_ID = "..."                # prioritaire sur la page si renseigné

# --- Google (optionnel) : voir scripts/google_oauth_setup.py ---
# GOOGLE_CLIENT_ID = "....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET = "..."
# GOOGLE_REFRESH_TOKEN = "..."
# GOOGLE_DRIVE_FOLDER_ID = "..."            # dossier de dépôt Drive (optionnel)

# --- Stockage ---
# PRISME_DB_PATH = "data/prisme.db"
